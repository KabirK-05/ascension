{
  "name": "ascension-mcp-local",
  "private": true,
  "type": "module",
  "description": "Ascension local bridge: a read-only stdio MCP server over the iCloud Drive export folder.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
