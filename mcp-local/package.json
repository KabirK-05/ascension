  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
